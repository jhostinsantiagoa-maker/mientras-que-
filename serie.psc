Algoritmo serie 
	definir contadornumeros,termino,cantidadterminos Como Entero
	Escribir "ingrese la cantidad de terminos a generar"
	leer cantidadterminos
	Mientras contadornumeros < cantidadterminos -1
		Imprimir termino, ","
		termino = termino +2
		contadornumeros = contadornumeros +1
		
	Fin Mientras
	Imprimir  "termino "
FinAlgoritmo
